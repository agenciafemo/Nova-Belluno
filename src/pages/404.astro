---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/not-found.css';

const title = 'Página não encontrada | Nova Belluno';
const description = 'A página que você tentou acessar não foi encontrada.';

/* Quem cai aqui costuma ter chegado por um link antigo. Em vez de só avisar do
   erro, a página oferece os destinos mais procurados, incluindo o webmail: o
   endereço www.novabelluno.com.br/webmail deixou de existir quando o site
   mudou de servidor, e a equipe ainda tem esse link salvo nos favoritos. */
const atalhos = [
  { href: '/', titulo: 'Página inicial', texto: 'Conheça a Nova Belluno' },
  { href: '/modalidades/', titulo: 'Modalidades', texto: 'Hospedagem temporária ou definitiva' },
  { href: '/quem-somos/', titulo: 'Quem somos', texto: 'Nossa história e nossas unidades' },
  { href: '/contato/', titulo: 'Contato', texto: 'Endereços, telefones e visitas' },
  { href: '/blog/', titulo: 'Blog', texto: 'Conteúdos para famílias e cuidadores' },
  { href: 'https://webmail.novabelluno.com.br', titulo: 'Webmail', texto: 'Acesso ao e-mail da equipe', externo: true },
];
---

<BaseLayout
  {title}
  {description}
  canonicalPath="/404/"
  bodyClass="internal-page not-found-page"
  headerVariant="inner"
  robots="noindex, follow, noarchive"
  showSkipLink={true}
>
  <main id="conteudo" class="not-found">
    <div class="not-found__inner">
      <header class="not-found__heading">
        <p class="not-found__eyebrow">Erro 404</p>
        <h1>Não encontramos esta página</h1>
        <p class="not-found__lead">
          O endereço pode ter mudado ou o link estar desatualizado. Escolha
          abaixo para onde você quer ir.
        </p>
      </header>

      <ul class="not-found__links">
        {atalhos.map((atalho) => (
          <li>
            <a
              href={atalho.href}
              target={atalho.externo ? '_blank' : undefined}
              rel={atalho.externo ? 'noopener' : undefined}
            >
              <strong>
                {atalho.titulo}
                {atalho.externo && <span aria-hidden="true">↗</span>}
              </strong>
              <span>{atalho.texto}</span>
            </a>
          </li>
        ))}
      </ul>

      <p class="not-found__help">
        Prefere falar com alguém?
        <a href="#" data-whatsapp data-whatsapp-message="Olá! Tentei acessar uma página do site e não encontrei.">
          Fale com a equipe no WhatsApp
        </a>
      </p>
    </div>
  </main>

  <script>
    import '../scripts/internal.ts';
  </script>
</BaseLayout>

<style>
  .not-found {
    padding: calc(var(--header-bar) + clamp(48px, 8vw, 88px)) 24px clamp(64px, 9vw, 104px);
    background: var(--color-beige-soft);
  }

  .not-found__inner {
    width: 100%;
    max-width: 920px;
    margin-inline: auto;
  }

  .not-found__eyebrow {
    margin-bottom: 14px;
    color: var(--color-primary-light);
    font-size: .72rem;
    font-weight: 700;
    letter-spacing: .14em;
    text-transform: uppercase;
  }

  .not-found h1 {
    max-width: 16ch;
    color: var(--color-primary);
    font-family: var(--font-heading);
    font-size: clamp(2.1rem, 5vw, 3.4rem);
    font-weight: 500;
    line-height: 1.05;
    letter-spacing: -.03em;
  }

  .not-found__lead {
    max-width: 52ch;
    margin-top: 18px;
    color: var(--color-ink-soft);
    font-size: clamp(.98rem, 1.3vw, 1.08rem);
    line-height: 1.7;
  }

  /* Uma lista de destinos resolve mais que um botão de "voltar ao início":
     quem errou o endereço quase sempre sabe o que procurava. */
  .not-found__links {
    margin-top: clamp(32px, 5vw, 48px);
    display: grid;
    gap: 14px;
    list-style: none;
  }

  .not-found__links a {
    display: grid;
    gap: 5px;
    padding: 20px 24px;
    border: 1px solid var(--color-beige);
    border-radius: var(--radius-md);
    background: var(--color-white);
    text-decoration: none;
    transition: border-color .2s ease, transform .2s ease;
  }

  .not-found__links a:hover,
  .not-found__links a:focus-visible {
    border-color: var(--color-primary-light);
    transform: translateY(-2px);
  }

  .not-found__links strong {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--color-primary);
    font-size: 1.02rem;
    font-weight: 600;
  }

  .not-found__links span {
    color: var(--color-ink-soft);
    font-size: .88rem;
    line-height: 1.5;
  }

  .not-found__help {
    margin-top: clamp(28px, 4vw, 40px);
    color: var(--color-ink-soft);
    font-size: .92rem;
    line-height: 1.7;
  }

  .not-found__help a {
    margin-left: 6px;
    color: var(--color-primary);
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .not-found a:focus-visible {
    outline: 3px solid var(--color-primary-light);
    outline-offset: 3px;
  }

  @media (min-width: 640px) {
    .not-found__links {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 760px) {
    .not-found { padding-inline: 40px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .not-found__links a { transition: none; }
    .not-found__links a:hover { transform: none; }
  }
</style>
