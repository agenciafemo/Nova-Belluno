---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogCard from '../../components/BlogCard.astro';
import { getPostSlug, getPublishedPosts } from '../../lib/blog';
import '../../styles/blog.css';

const posts = await getPublishedPosts();
const featuredPost = posts.find((post) => post.data.featured) ?? posts[0];

/* A grade recebe todos os artigos, inclusive o destacado, para que a busca e o
   filtro percorram uma lista só. O destacado entra oculto e só aparece na
   grade quando há filtragem ativa, evitando aparecer duas vezes. */
const categories = [...new Set(posts.map((post) => post.data.category))].sort(
  (first, second) => first.localeCompare(second, 'pt-BR'),
);

/* Índice de busca montado no build: título, resumo, categoria e tags em um
   único atributo, para o script comparar sem percorrer o DOM de cada cartão. */
const searchIndex = (post: (typeof posts)[number]) =>
  [post.data.title, post.data.description, post.data.category, ...post.data.tags].join(' ');
const title = 'Blog sobre cuidado e envelhecimento | Nova Belluno';
const description = 'Informação para famílias e cuidadores sobre envelhecimento, bem-estar, convivência e decisões relacionadas ao cuidado da pessoa idosa.';
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Blog',
      '@id': 'https://novabelluno.com.br/blog/#blog',
      url: 'https://novabelluno.com.br/blog/',
      name: 'Conteúdos Nova Belluno',
      description,
      inLanguage: 'pt-BR',
      publisher: { '@id': 'https://novabelluno.com.br/#organization' },
      blogPost: posts.map((post) => ({
        '@type': 'BlogPosting',
        headline: post.data.title,
        url: `https://novabelluno.com.br/blog/${getPostSlug(post)}/`,
        datePublished: post.data.publishedAt.toISOString(),
        dateModified: (post.data.updatedAt ?? post.data.publishedAt).toISOString(),
        image: new URL(post.data.coverImage, 'https://novabelluno.com.br').href,
      })),
    },
    {
      '@type': 'BreadcrumbList',
      '@id': 'https://novabelluno.com.br/blog/#breadcrumb',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Início', item: 'https://novabelluno.com.br/' },
        { '@type': 'ListItem', position: 2, name: 'Blog', item: 'https://novabelluno.com.br/blog/' },
      ],
    },
  ],
};
---

<BaseLayout
  {title}
  {description}
  canonicalPath="/blog/"
  bodyClass="internal-page blog-page"
  headerVariant="inner"
  activePage="blog"
  showSkipLink
  {jsonLd}
>
  <main id="conteudo">
    <section class="blog-page__hero" aria-labelledby="blog-title">
      <div class="blog-page__hero-inner">
        <nav class="internal-hero__breadcrumb" aria-label="Navegação estrutural">
          <a href="/">Início</a>
          <span aria-hidden="true">/</span>
          <span aria-current="page">Blog</span>
        </nav>
        <p class="internal-hero__eyebrow">Conteúdos Nova Belluno</p>
        <h1 id="blog-title">Informação para cuidar com mais tranquilidade</h1>
        <p>
          Artigos para famílias e cuidadores sobre envelhecimento, bem-estar e
          decisões do dia a dia.
        </p>
      </div>
    </section>

    <section class="blog-page__content" aria-label="Artigos do blog" data-blog-index>
      <div class="blog-page__content-inner">
        {posts.length > 0 ? (
          <>
            <form class="blog-toolbar" data-blog-toolbar hidden role="search" onsubmit="return false">
              <div class="blog-toolbar__search">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="2" stroke-linecap="round" aria-hidden="true">
                  <circle cx="11" cy="11" r="7"/><path d="m20 20-3.2-3.2"/>
                </svg>
                <label class="blog-toolbar__label" for="blog-search">Buscar artigos</label>
                <input id="blog-search" type="search" data-blog-search
                       placeholder="Buscar artigos" autocomplete="off">
              </div>
              <div class="blog-toolbar__categories" role="group" aria-label="Filtrar por categoria">
                <button type="button" class="blog-chip" data-blog-category="todos" aria-pressed="true">Todos</button>
                {categories.map((category) => (
                  <button type="button" class="blog-chip" data-blog-category={category} aria-pressed="false">{category}</button>
                ))}
              </div>
            </form>

            <p class="blog-toolbar__status" data-blog-status role="status" aria-live="polite"></p>

            {featuredPost && (
              <div class="blog-page__featured">
                <p class="blog-page__section-label">Leitura em destaque</p>
                <BlogCard post={featuredPost} featured />
              </div>
            )}

            <div class="blog-page__grid">
              {posts.map((post) => (
                <div class="blog-page__grid-item" data-blog-item
                     data-category={post.data.category}
                     data-search={searchIndex(post)}
                     data-featured={post.id === featuredPost?.id ? 'true' : undefined}
                     hidden={post.id === featuredPost?.id}>
                  <BlogCard {post} />
                </div>
              ))}
            </div>

            <p class="blog-page__no-results" data-blog-empty hidden>
              Nenhum artigo corresponde à busca. Tente outra palavra ou volte para
              <button type="button" class="blog-page__no-results-reset" data-blog-reset>todas as categorias</button>.
            </p>
          </>
        ) : (
          <div class="blog-page__empty">
            <p class="blog-page__section-label">Conteúdos Nova Belluno</p>
            <h2>Estamos preparando novas leituras</h2>
            <p>Em breve, este espaço reunirá conteúdos para famílias e cuidadores.</p>
          </div>
        )}

        <aside class="blog-page__partner-card" aria-label="Conteúdo parceiro Longevidade365">
          <div class="blog-page__partner-brand">
            <img
              src="/assets/img/partners/longevidade365-logo.png"
              alt="Longevidade365"
              width="1765"
              height="204"
              loading="lazy"
              decoding="async"
            />
          </div>
          <div class="blog-page__partner-copy">
            <p class="blog-page__section-label">Conteúdo parceiro</p>
            <h2>Informação para viver melhor em todas as fases da longevidade</h2>
            <p>Conheça o Longevidade365, um portal com conteúdos sobre saúde, cultura, finanças e bem-estar para apoiar escolhas mais conscientes.</p>
            <a class="action-button action-button--inverse" href="https://longevidade365.com.br/" target="_blank" rel="noopener">
              <span class="action-button__label">Conhecer Longevidade365</span>
              <span class="action-button__hover" aria-hidden="true">
                <span>Conhecer Longevidade365</span>
                <svg class="action-button__arrow" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
              </span>
              <span class="action-button__fill" aria-hidden="true"></span>
            </a>
          </div>
        </aside>

      </div>
    </section>

    <section class="internal-contact" aria-labelledby="blog-contact-title">
      <div class="internal-contact__inner">
        <div>
          <p class="internal-contact__eyebrow">Conversa individual</p>
          <h2 id="blog-contact-title">Cada família vive um momento diferente</h2>
        </div>
        <div class="internal-contact__content">
          <p>
            Os conteúdos ajudam a organizar dúvidas, mas uma conversa com a equipe
            permite entender as modalidades, unidades e possibilidades de acolhimento.
          </p>
          <div class="internal-contact__actions">
            <a class="action-button action-button--whatsapp" href="#" data-whatsapp
               data-whatsapp-message="Olá! Li um conteúdo no blog da Nova Belluno e gostaria de conversar com a equipe.">
              <span class="action-button__label">Falar no WhatsApp</span>
              <span class="action-button__hover" aria-hidden="true">
                <span>Falar no WhatsApp</span>
                <svg class="action-button__arrow" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
              </span>
              <span class="action-button__fill" aria-hidden="true"></span>
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <script>
    import '../../scripts/internal.ts';
    import '../../scripts/blog-filter.ts';
  </script>
</BaseLayout>
