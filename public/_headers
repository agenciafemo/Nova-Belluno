/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Content-Security-Policy: default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'; script-src 'self' 'unsafe-inline' https://www.jotform.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https://*.supabase.co https://www.jotform.com https://lh3.googleusercontent.com; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://www.jotform.com; frame-src https://www.google.com https://maps.google.com https://www.jotform.com https://form.jotform.com; upgrade-insecure-requests
  Cache-Control: public, max-age=0, must-revalidate

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/assets/img/optimized/*
  Cache-Control: public, max-age=31536000, immutable

/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/assets/img/hero/optimized/*
  Cache-Control: public, max-age=31536000, immutable

/assets/img/services/optimized/*
  Cache-Control: public, max-age=31536000, immutable

/assets/img/local/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/assets/img/instagram/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/sitemap-*.xml
  Cache-Control: public, max-age=3600, must-revalidate

/robots.txt
  Cache-Control: public, max-age=3600, must-revalidate

/rss.xml
  Cache-Control: public, max-age=3600, must-revalidate

/admin/*
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow, noarchive
