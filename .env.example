# Variáveis com prefixo PUBLIC_ podem ser enviadas ao navegador.
PUBLIC_SITE_URL=https://novabelluno.com.br

# Valores públicos do projeto Supabase. A publishable key é segura no cliente
# quando as tabelas estão protegidas por grants mínimos e RLS.
PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_SUBSTITUA_AQUI
PUBLIC_SUPABASE_ADMIN_EMAIL=administrador@seudominio.com.br

# Segredos do futuro backend devem ficar sem o prefixo PUBLIC_ e nunca
# devem ser usados em componentes ou scripts executados no navegador.
# SUPABASE_SERVICE_ROLE_KEY= # somente em servidor/CI; nunca usar no navegador

# Integração do grid do Instagram (Meta Developers > app > Instagram).
# Sem o prefixo PUBLIC_: o token dá acesso de leitura à conta da empresa e
# nunca pode chegar ao navegador. Usado apenas por scripts/sync-instagram.mjs.
# A rota é escolhida pelo prefixo do token: IGAA usa graph.instagram.com e
# vale 60 dias; EAA é token de usuário do sistema, usa graph.facebook.com e
# não expira. Trocar de uma para a outra é só substituir o valor abaixo.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_ACCESS_TOKEN=

# Necessário apenas com token de usuário do sistema. Sem ele o script descobre
# a conta pela Página vinculada e imprime o ID para você fixar aqui.
INSTAGRAM_BUSINESS_ACCOUNT_ID=
